# Pipeline purpose - prepare targets for folding,
# run folding with RNAfold, collect results and preparation for visualization

import os

workdir: config['input_dir']
path_to_samples = config['input_dir']

samples, = glob_wildcards(os.path.join(path_to_samples, "{samples}_R1_trimmed_T7_HH_HDV.fastq.gz"))

print(samples)

rule all:
    input:
        openen_results = expand(os.path.join(path_to_samples, "{index}_i50_51_openen"), index=samples),
        probs_results = expand(os.path.join(path_to_samples,"{index}_i50_51_probs"),index=samples),
        mfe_results = expand(os.path.join(path_to_samples,"{index}_mfe_rnafold.tsv"),index=samples)

rule target_preparation:
    input:
        reads = os.path.join(path_to_samples, "{index}_R1_trimmed_T7_HH_HDV.fastq.gz")
    output:
        output_log = os.path.join(path_to_samples, "{index}_targets_info"),
        all_targets = os.path.join(path_to_samples,"{index}_i50_51.fasta")
    params:
        output_wo_ext = os.path.join(path_to_samples, "{index}")
    run:
        script_path = workflow.source_path("prepare_for_folding/targets_from_reads.py")
        shell(f"""python {script_path} -i {input.reads} -o {params.output_wo_ext} > {output.output_log}""")


rule folding_openen:
    input:
        target_prep_log = rules.target_preparation.output.output_log,
        samples = rules.target_preparation.output.all_targets
    output:
        openen_results = directory(os.path.join(path_to_samples, "{index}_openen"))
    shell:
        """
        mkdir {output.openen_results}
        cd {output.openen_results}
        RNAplfold -O < {input.samples}
        """

rule collect_openen:
    input:
        folder_with_results = rules.folding_openen.output.openen_results
    output:
        path_to_output = os.path.join(path_to_samples,"{index}_i50_51_openen")
    params:
        fasta = rules.target_preparation.output.all_targets
    run:
        script_path = workflow.source_path("folding_analysis/collect_rnaplfold_results.py")
        shell(f"""python {script_path} -i {input.folder_with_results} -o {output.path_to_output} -f {params.fasta} -s {wildcards.index} -t en""")


rule folding_probs:
    input:
        target_prep_log = rules.target_preparation.output.output_log,
        samples = rules.target_preparation.output.all_targets
    output:
        probs_results = directory(os.path.join(path_to_samples, "{index}_probs"))
    shell:
        """
        mkdir {output.probs_results}
        cd {output.probs_results}
        RNAplfold -u 2 < {input.samples}
        """

rule collect_probs:
    input:
        folder_with_results = rules.folding_probs.output.probs_results
    output:
        path_to_output = os.path.join(path_to_samples,"{index}_i50_51_probs")
    params:
        fasta = rules.target_preparation.output.all_targets
    run:
        script_path = workflow.source_path("folding_analysis/collect_rnaplfold_results.py")
        shell(f"""python {script_path} -i {input.folder_with_results} -o {output.path_to_output} -f {params.fasta} -s {wildcards.index} -t prob""")


rule folding_mfe:
    input:
        target_prep_log = rules.target_preparation.output.output_log,
        samples = rules.target_preparation.output.all_targets
    output:
        mfe_raw_results = os.path.join(path_to_samples,"{index}_mfe_rnafold_out")
    shell:
        """
        RNAfold -p -d2 --noLP < {input.samples} > {output.mfe_raw_results}
        """


rule collect_mfe:
    input:
        mfe_raw_results = rules.folding_mfe.output.mfe_raw_results
    output:
        mfe_parced_results = os.path.join(path_to_samples,"{index}_mfe_rnafold.tsv")
    run:
        script_path = workflow.source_path("folding_analysis/mfe_results.py")
        shell(f"""python {script_path} -i {input.mfe_raw_results} -o {output.mfe_parced_results}""")
